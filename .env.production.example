# ==============================================================================
# zivaBooks — Production Environment Template
# ==============================================================================
# Copy to /etc/zivabooks/production.env or your server .env file
# ==============================================================================
COMPOSE_PROJECT_NAME=zivabooks
DEBUG=false
SECRET_KEY=generate-a-strong-secret-key-with-openssl-rand-hex-32
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
PORT=8000

DATABASE_ENGINE=postgres
POSTGRES_DB=zivaBooks
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate-a-strong-db-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

USE_REDIS_CACHE=true
REDIS_CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_CONCURRENCY=1
WEB_WORKERS=1

AUTO_MIGRATE=true
AUTO_SEED=true

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=noreply@yourdomain.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=zivaBooks <noreply@yourdomain.com>

GEMINI_API_KEY=
NVIDIA_API_KEY=
