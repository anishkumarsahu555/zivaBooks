# Copy OUTSIDE the repository to /etc/zivabooks/production.env (mode 600).
# Use single quotes around values containing $ or # to keep them literal.
COMPOSE_PROJECT_NAME=zivabooks-prod
APP_DOMAIN=zivainfotech.tech
APP_IMAGE=zivabooks:release-001
WEB_PORT=8001
DATA_ROOT=/srv/zivabooks/data
BACKUP_ROOT=/backups/zivabooks

# Required: generate distinct random values, do not use placeholders.
SECRET_KEY=
POSTGRES_DB=zivabooks
POSTGRES_USER=zivabooks
POSTGRES_PASSWORD=

# Starting budgets for this app, not all apps on the VPS combined.
WEB_WORKERS=1
WEB_MEMORY_LIMIT=1024m
WEB_CPU_LIMIT=0.75
DB_MEMORY_LIMIT=1536m
DB_CPU_LIMIT=0.75
WORKER_MEMORY_LIMIT=768m
WORKER_CPU_LIMIT=0.50
CELERY_CONCURRENCY=1

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@zivainfotech.tech
GEMINI_API_KEY=
NVIDIA_API_KEY=
