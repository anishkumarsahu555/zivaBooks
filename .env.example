# ==============================================================================
# zivaBooks — Environment Configuration Template
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# Then launch the single compose stack:
#   docker compose up -d --build
# ==============================================================================

# Core Django Settings
DEBUG=false
SECRET_KEY=django-insecure-generate-a-strong-random-secret-key-for-production
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001
PORT=8001

# Database Settings (postgres for Docker stack / sqlite for host dev)
DATABASE_ENGINE=postgres
POSTGRES_DB=zivaBooks
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis Cache & Celery Task Broker
USE_REDIS_CACHE=true
REDIS_CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_CONCURRENCY=1

# Automation & Worker Tuning
AUTO_MIGRATE=true
AUTO_SEED=true
WEB_WORKERS=1

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=zivaBooks <noreply@zivainfotech.tech>

# AI API Keys (Optional)
GEMINI_API_KEY=
NVIDIA_API_KEY=