DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me

# sqlite or postgres
DATABASE_ENGINE=sqlite

# SQLite
SQLITE_PATH=/Users/anishkumarsahu/ZivaInfotech/longTerm/zivaBooks/db.sqlite3

# Postgres
POSTGRES_DB=zivaBooks
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Local AI via Ollama
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b
OLLAMA_TIMEOUT_SECONDS=20
OLLAMA_MAX_TOKENS=250
OLLAMA_TEMPERATURE=0.2
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password
DEFAULT_FROM_EMAIL=zivaBooks <your_email@gmail.com>
PASSWORD_RESET_TIMEOUT=3600

# Redis & Celery Configuration (Host port 6380 maps to Docker internal 6379)
REDIS_PORT=6380
REDIS_CACHE_URL=redis://127.0.0.1:6380/1
CELERY_BROKER_URL=redis://127.0.0.1:6380/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6380/0