# Copy to .env.local. Match credentials of your EXISTING Docker database.
# Use single quotes around values containing $ or #.
COMPOSE_PROJECT_NAME=zivabooks
APP_IMAGE=zivabooks:local
APP_DOMAIN=localhost
WEB_PORT=8000
DATA_ROOT=./local-data/zivabooks
# For operations.py backups, replace with an absolute app-specific path.
BACKUP_ROOT=./local-backups/zivabooks
SECRET_KEY=zivabooks-docker-local-dev-insecure-key
POSTGRES_DB=zivaBooks
POSTGRES_USER=zivabooks
POSTGRES_PASSWORD=zivabooks-local-password
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
DEBUG=true
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=0
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
WEB_WORKERS=1
CELERY_CONCURRENCY=1
