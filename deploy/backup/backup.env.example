# Install as /etc/zivabooks/backup.env, mode 600. This is a systemd EnvironmentFile.
RESTIC_PASSWORD_FILE=/etc/zivabooks/restic-password
LOCAL_KEEP_WITHIN=3d
# Leave unset until a provider is chosen and the remote repository is initialized.
# OFFSITE_REPOSITORY=s3:https://your-storage-endpoint/your-bucket/zivabooks
# OFFSITE_PASSWORD_FILE=/etc/zivabooks/offsite-password
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
