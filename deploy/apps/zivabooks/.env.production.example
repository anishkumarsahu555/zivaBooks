# ==============================================================================
# zivaBooks — Production Environment Variables
# Location on VPS: /opt/apps/zivabooks/.env
# Permissions: chmod 600 /opt/apps/zivabooks/.env
# ==============================================================================

# Core Django Settings
DEBUG=false
SECRET_KEY=replace-with-a-64-character-random-secret-key-in-production
ALLOWED_HOSTS=app.zivabooks.com,zivabooks_web,localhost
CSRF_TRUSTED_ORIGINS=https://app.zivabooks.com
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true

# Database Configuration (PostgreSQL container)
DATABASE_ENGINE=postgres
POSTGRES_DB=zivaBooks
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-secure-postgres-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60
DB_CONN_HEALTH_CHECKS=true

# Persistent Storage Mount Paths
DATA_DIR=/opt/data/zivabooks
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles

# Redis Cache & Broker Configuration
USE_REDIS_CACHE=true
REDIS_CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Email SMTP Notification Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=support@zivabooks.com
EMAIL_HOST_PASSWORD=your-google-app-password
DEFAULT_FROM_EMAIL=zivaBooks <support@zivabooks.com>
ADMIN_NOTIFICATION_EMAIL=admin@zivabooks.com
LICENSE_INQUIRY_NOTIFY_ADMIN=true
PASSWORD_RESET_TIMEOUT=3600

# Ziva AI Integration (Optional)
OPENAI_API_KEY=sk-proj-...
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:e2b

# Deployment Flags
AUTO_SEED=false
